{
  "schemaVersion": 1,
  "purpose": "#167 characterization of the current public Trader and Market Data REST read surface, including wire mapping and response behavior.",
  "evidenceLimit": "Every request uses actual built Node SDK clients and HttpClient with synthetic token data and fake fetch. No Schwab endpoint, user account, credential store, .env, or .state is accessed.",
  "cases": [
    {
      "id": "trader-account-number-hash-list",
      "client": "trader",
      "method": "getAccountNumbersWithResponse",
      "args": [],
      "transport": { "status": 200, "body": [{ "accountNumber": "synthetic-account", "hashValue": "synthetic-hash" }] },
      "expectedRequest": { "path": "/trader/v1/accounts/accountNumbers", "query": {} },
      "expectedOutcome": { "kind": "response", "status": 200, "body": [{ "accountNumber": "synthetic-account", "hashValue": "synthetic-hash" }] }
    },
    {
      "id": "trader-accounts-positions-field",
      "client": "trader",
      "method": "getAccountsWithResponse",
      "args": [{ "fields": "positions" }],
      "transport": { "status": 200, "body": [{ "securitiesAccount": { "accountNumber": "synthetic-account", "positions": [] } }] },
      "expectedRequest": { "path": "/trader/v1/accounts", "query": { "fields": "positions" } },
      "expectedOutcome": { "kind": "response", "status": 200, "body": [{ "securitiesAccount": { "accountNumber": "synthetic-account", "positions": [] } }] }
    },
    {
      "id": "trader-account-hash-path-encoding",
      "client": "trader",
      "method": "getAccountWithResponse",
      "args": [" synthetic/hash+ ", { "fields": "positions" }],
      "transport": { "status": 200, "body": { "securitiesAccount": { "accountNumber": "synthetic-account" } } },
      "expectedRequest": { "path": "/trader/v1/accounts/synthetic%2Fhash%2B", "query": { "fields": "positions" } },
      "expectedOutcome": { "kind": "response", "status": 200, "body": { "securitiesAccount": { "accountNumber": "synthetic-account" } } }
    },
    {
      "id": "trader-orders-query-preserves-false-zero-and-omits-undefined",
      "client": "trader",
      "method": "getOrdersWithResponse",
      "args": ["synthetic-hash", { "fromEnteredTime": "2026-08-12T09:30:00-04:00", "toEnteredTime": "2026-08-12T16:00:00-04:00", "maxResults": 0, "status": "WORKING", "includeSomething": false, "omitThis": null }],
      "transport": { "status": 200, "body": [] },
      "expectedRequest": { "path": "/trader/v1/accounts/synthetic-hash/orders", "query": { "fromEnteredTime": "2026-08-12T09:30:00-04:00", "toEnteredTime": "2026-08-12T16:00:00-04:00", "maxResults": "0", "status": "WORKING", "includeSomething": "false" } },
      "expectedOutcome": { "kind": "response", "status": 200, "body": [] }
    },
    {
      "id": "trader-order-id-path",
      "client": "trader",
      "method": "getOrderWithResponse",
      "args": ["synthetic-hash", "9007199254740993"],
      "transport": { "status": 200, "body": { "orderId": 42, "status": "WORKING", "futureBrokerField": "preserved" } },
      "expectedRequest": { "path": "/trader/v1/accounts/synthetic-hash/orders/9007199254740993", "query": {} },
      "expectedOutcome": { "kind": "response", "status": 200, "body": { "orderId": 42, "status": "WORKING", "futureBrokerField": "preserved" } }
    },
    {
      "id": "trader-cross-account-orders-query",
      "client": "trader",
      "method": "getOrdersAcrossAccountsWithResponse",
      "args": [{ "fromEnteredTime": "start", "toEnteredTime": "end", "status": "FILLED" }],
      "transport": { "status": 200, "body": [{ "orderId": 42, "status": "FILLED" }] },
      "expectedRequest": { "path": "/trader/v1/orders", "query": { "fromEnteredTime": "start", "toEnteredTime": "end", "status": "FILLED" } },
      "expectedOutcome": { "kind": "response", "status": 200, "body": [{ "orderId": 42, "status": "FILLED" }] }
    },
    {
      "id": "trader-transactions-query",
      "client": "trader",
