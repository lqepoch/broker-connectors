    },
    {
      "id": "trader-streamer-info-array-preference-selects-first",
      "client": "trader",
      "method": "getStreamerInfo",
      "args": [],
      "transport": { "status": 200, "body": [{ "streamerInfo": [{ "streamerSocketUrl": "wss://streamer.example.invalid", "schwabClientCustomerId": "synthetic-customer", "schwabClientCorrelId": "synthetic-correlation", "schwabClientChannel": "N9", "schwabClientFunctionId": "synthetic-function" }] }, { "streamerInfo": [{ "streamerSocketUrl": "wss://ignored.example.invalid", "schwabClientCustomerId": "ignored", "schwabClientCorrelId": "ignored", "schwabClientChannel": "N9", "schwabClientFunctionId": "ignored" }] }] },
      "expectedRequest": { "path": "/trader/v1/userPreference", "query": {} },
      "expectedOutcome": { "kind": "body", "value": { "streamerSocketUrl": "wss://streamer.example.invalid", "schwabClientCustomerId": "synthetic-customer", "schwabClientCorrelId": "synthetic-correlation", "schwabClientChannel": "N9", "schwabClientFunctionId": "synthetic-function" } }
    },
    {
      "id": "trader-streamer-info-missing-preference-fails",
      "client": "trader",
      "method": "getStreamerInfo",
      "args": [],
      "transport": { "status": 200, "body": {} },
      "expectedRequest": { "path": "/trader/v1/userPreference", "query": {} },
      "expectedOutcome": { "kind": "error", "name": "Error", "message": "Streamer info unavailable in user preferences" }
    },
    {
      "id": "market-batch-quotes-joins-symbols-and-fields",
