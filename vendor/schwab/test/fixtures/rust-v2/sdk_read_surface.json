      "args": ["QQQ   260814P00740000"],
      "transport": { "status": 200, "body": { "QQQ   260814P00740000": { "assetMainType": "OPTION", "symbol": "QQQ   260814P00740000", "realtime": true, "reference": { "underlying": "QQQ", "contractType": "PUT", "strikePrice": 740, "expirationYear": 2026, "expirationMonth": 8, "expirationDay": 14 }, "quote": { "bidPrice": 29.9, "askPrice": 30.1, "quoteTime": 1700000000000, "delta": -0.42 } } } },
      "expectedRequest": { "path": "/marketdata/v1/quotes", "query": { "symbols": "QQQ   260814P00740000", "fields": "quote,reference" } },
      "expectedOutcome": { "kind": "quote", "value": { "symbol": "QQQ   260814P00740000", "underlying": "QQQ", "contractType": "PUT", "expiration": "2026-08-14", "strike": 740, "realtime": true, "bid": 29.9, "ask": 30.1, "mid": 30, "spread": 0.20000000000000284, "quoteTime": 1700000000000, "delta": -0.42 } }
    },
    {
      "id": "market-vertical-option-quote-derives-two-leg-market",
      "classification": "BUG_IN_LEGACY",
      "legacyBugNote": "The legacy strategy quote helper derives prices with JavaScript IEEE-754 numbers. Rust migration must use exact decimal pricing before applying trading thresholds.",
      "client": "marketData",
      "method": "getVerticalOptionQuote",
      "args": ["QQQ   260814P00740000", "QQQ   260814P00739000"],
      "transport": { "status": 200, "body": { "QQQ   260814P00740000": { "assetMainType": "OPTION", "symbol": "QQQ   260814P00740000", "realtime": true, "reference": { "underlying": "QQQ", "contractType": "PUT", "strikePrice": 740, "expirationYear": 2026, "expirationMonth": 8, "expirationDay": 14 }, "quote": { "bidPrice": 29.9, "askPrice": 30.1, "quoteTime": 1700000000000 } }, "QQQ   260814P00739000": { "assetMainType": "OPTION", "symbol": "QQQ   260814P00739000", "realtime": true, "reference": { "underlying": "QQQ", "contractType": "PUT", "strikePrice": 739, "expirationYear": 2026, "expirationMonth": 8, "expirationDay": 14 }, "quote": { "bidPrice": 28.95, "askPrice": 29.05, "quoteTime": 1700000000000 } } } },
      "expectedRequest": { "path": "/marketdata/v1/quotes", "query": { "symbols": "QQQ   260814P00740000,QQQ   260814P00739000", "fields": "quote,reference" } },
      "expectedOutcome": { "kind": "vertical", "value": { "derivedBid": 0.8499999999999979, "derivedAsk": 1.1500000000000021, "derivedMid": 1, "derivedSpread": 0.30000000000000426, "sameUnderlying": true, "sameExpiration": true, "sameContractType": true } }
    },
