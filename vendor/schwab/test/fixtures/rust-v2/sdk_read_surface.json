      "transport": { "status": 200, "body": [{ "activityId": 42, "type": "TRADE", "symbol": "QQQ" }] },
      "expectedRequest": { "path": "/trader/v1/accounts/synthetic-hash/transactions", "query": { "startDate": "2026-08-12", "endDate": "2026-08-13", "types": "TRADE", "symbol": "QQQ" } },
